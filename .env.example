# url-picker configuration. All settings are optional.
#
# Copy this file into the plugin's config dir and edit it:
#   cp .env.example "$(herdr plugin config-dir url-picker)/.env"
# Then reopen the picker — no relink needed.

# Include file:// URLs (local paths). Off by default because build tools print
# many file:// node_modules paths that drown out real links. Set to 1 to enable.
# URL_PICKER_INCLUDE_FILES=1

# How many lines of pane scrollback to scan for URLs. Default: 2000.
# URL_PICKER_LINES=2000

# Advanced: full control over which schemes match, as a grep ERE alternation.
# Overrides URL_PICKER_INCLUDE_FILES. Example (adds file://):
# URL_PICKER_SCHEMES=https?|ftp|file
